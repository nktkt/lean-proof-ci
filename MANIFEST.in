include LICENSE README.md README.ja.md CONTRIBUTING.md CHANGELOG.md action.yml PROOFREVIEW.ja.md
recursive-include .github *.yml
recursive-include docs *.jpg
recursive-include lean_proof_ci *.lean
recursive-include examples *.lean *.toml *.json *.md *.py lean-toolchain
recursive-include tests *.py
prune examples/basic/.lake
prune examples/basic/.proof-ci
prune examples/broken/.lake
prune examples/broken/.proof-ci
prune examples/basic/.lean-proof-ci-*
prune examples/broken/.lean-proof-ci-*
